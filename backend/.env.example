# .env.example ── copy to .env and fill in real values

PORT=3000

CDOGS_AUTH_URL=https://loginproxy.gov.bc.ca/auth/realms/standard/protocol/openid-connect/token
CDOGS_SERVICE_URL=https://cdogs.api.gov.bc.ca/api/v2

CDOGS_CLIENT_ID=your-client-id-here
CDOGS_CLIENT_SECRET=your-client-secret-here
TEMPLATE_ID=your-template-uuid-here

# Optional
MAX_FILE_SIZE_MB=25
